# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Neon direct connection string (used by Prisma for migrations)
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# NextAuth v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# Base URL of the application
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Generic OIDC / SSO provider (optional).
# Leave blank to disable. If all three (issuer, id, secret) are set, a
# "Continue with <AUTH_OIDC_NAME>" button appears on the sign-in and
# sign-up pages. The issuer must support OIDC discovery at
# <issuer>/.well-known/openid-configuration. The callback URL to whitelist
# with your IdP is: <AUTH_URL>/api/auth/callback/oidc
AUTH_OIDC_ISSUER=""
AUTH_OIDC_ID=""
AUTH_OIDC_SECRET=""
AUTH_OIDC_NAME="SSO"

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to hide the "Continue with Google" button and skip the Google
# provider entirely, even if AUTH_GOOGLE_ID/SECRET are set.
AUTH_DISABLE_GOOGLE="false"

# Set to "true" to disable account creation. The /auth/signup page will
# redirect to /auth/signin and the sign-up server action will reject requests.
AUTH_DISABLE_SIGNUP="false"

# Set to "true" to hide the marketing landing page and self-hosting docs from
# unauthenticated users — useful for private deployments. Signed-in users
# continue to the dashboard; everyone else gets redirected to /auth/signin.
DISABLE_PUBLIC_PAGES="false"

# Set to "true" to expose the admin-only /dashboard/device-logs page and the
# /api/device-logs/{ingest,stream} routes. Pairs with the log-bridge util in
# utils/log-bridge — it forwards firmware UDP broadcasts to the ingest
# endpoint, the server fans them out via SSE. Nothing is persisted.
DEVICE_LOGS_ENABLED="false"

# Bearer token the log-bridge presents to /api/device-logs/ingest. Generate
# with: openssl rand -hex 32. Required when DEVICE_LOGS_ENABLED is true.
DEVICE_LOGS_INGEST_TOKEN=""

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM (encrypt Jellyfin API tokens at rest)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JELLYFIN_ENCRYPTION_KEY="your-64-char-hex-key-here"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com — used for email verification and password reset
RESEND_API_KEY="re_your_resend_api_key"
# Verified sender domain/address in Resend
EMAIL_FROM="Jellybox <noreply@yourdomain.com>"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Jellybox Server"

# ─── Firmware OTA ─────────────────────────────────────────────────────────────
# GitHub repo (owner/name) the server polls every 5 min for a firmware manifest
# to advertise to paired devices on /api/device/me. Override if you maintain
# your own firmware fork.
# FIRMWARE_REPO="Nikorag/Jellybox-Firmware"
#
# Pin all devices to a specific firmware tag instead of the latest GitHub
# release. Leave unset (or "latest") to always advertise the newest release.
# Use a tag exactly as it appears in the firmware repo, e.g. "v0.0.2".
# FIRMWARE_VERSION="latest"

# ─── MQTT / Home Assistant (optional) ────────────────────────────────────────
# When MQTT_URL is set, every Jellybox device auto-registers in Home Assistant
# via MQTT Discovery as a device with three sensors (last scanned tag, last
# seen, last tag scanned at) plus a "Tag scanned" event entity that fires on
# every successful scan. Leave MQTT_URL blank to disable.
#
# Two transports are supported:
#
#   • Direct MQTT — set MQTT_URL to an mqtt://, mqtts://, ws://, or wss://
#     broker the server can reach directly (Docker compose, Tailscale, etc).
#     MQTT_USERNAME / MQTT_PASSWORD authenticate against the broker.
#       MQTT_URL="mqtt://mosquitto:1883"
#       MQTT_USERNAME=""
#       MQTT_PASSWORD=""
#
#   • Pull bridge — leave MQTT_URL UNSET and set MQTT_BRIDGE_TOKEN. The
#     mqtt-bridge util (see utils/mqtt-bridge) connects outbound from your
#     LAN to /api/mqtt/stream, receives published messages over an
#     authenticated SSE stream, and republishes them to your internal
#     Mosquitto. Nothing on your home network needs to be exposed to the
#     internet. Use this on Vercel.
#       MQTT_BRIDGE_TOKEN=""
# MQTT_URL=""
# MQTT_USERNAME=""
# MQTT_PASSWORD=""
# MQTT_BRIDGE_TOKEN=""
#
# Discovery prefix HA listens on (default: homeassistant — only override if
# you've customised it in HA's MQTT integration).
# MQTT_DISCOVERY_PREFIX="homeassistant"
#
# Root topic for Jellybox state/event traffic (default: jellybox).
# MQTT_BASE_TOPIC="jellybox"
